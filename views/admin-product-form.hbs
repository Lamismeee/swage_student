<div class="page-container">
  <div class="page-header">
    <a href="/admin/products" class="back-link">Back to products</a>
    <h1 class="page-title">{{title}}</h1>
  </div>

  {{#if error}}
    <div class="alert alert-error">{{error}}</div>
  {{/if}}

  <form method="POST" action="{{action}}" class="admin-form">
    <div class="form-section">
      <h2 class="form-section-title">Product details</h2>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="name">Name</label>
          <input class="form-input" id="name" name="name" value="{{product.name}}" required>
        </div>
        <div class="form-group">
          <label class="form-label" for="price">Price</label>
          <input class="form-input" id="price" name="price" type="number" min="0.01" step="0.01" value="{{product.price}}" required>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="category">Category</label>
          <input class="form-input" id="category" name="category" list="category-options" value="{{product.category}}" required>
          <datalist id="category-options">
            {{#each categories}}<option value="{{this}}"></option>{{/each}}
          </datalist>
        </div>
        <div class="form-group">
          <label class="form-label" for="type">Type</label>
          <input class="form-input" id="type" name="type" list="type-options" value="{{product.type}}" required>
          <datalist id="type-options">
            {{#each types}}<option value="{{this}}"></option>{{/each}}
          </datalist>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="image">Image path</label>
          <input class="form-input" id="image" name="image" value="{{product.image}}" required>
        </div>
        <div class="form-group">
          <label class="form-label" for="badge">Badge</label>
          <input class="form-input" id="badge" name="badge" value="{{product.badge}}" placeholder="New, Sale, Bestseller">
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="desc">Description</label>
        <textarea class="form-input form-textarea" id="desc" name="desc" rows="4">{{product.desc}}</textarea>
      </div>
    </div>

    <div class="admin-form-actions">
      <a href="/admin/products" class="btn-ghost">Cancel</a>
      <button type="submit" class="btn-primary admin-save-btn">Save product</button>
    </div>
  </form>
</div>
